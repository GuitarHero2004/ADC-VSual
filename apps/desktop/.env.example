# Runtime configuration for the Electron main process. Copy to .env.local.
# Use HTTPS for a deployed backend; local development may use loopback HTTP.
VSUAL_API_BASE_URL=http://127.0.0.1:3000
VSUAL_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VSUAL_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Optional: omit to use the backend's configured workspace.
VSUAL_WORKSPACE_ID=
# Never place ElevenLabs, Avis, database, or service-role credentials here.
