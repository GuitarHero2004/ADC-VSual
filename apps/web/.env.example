# No environment variables are needed for this foundation.
# Reserved examples for later server-side integration; currently unused.
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# DATABASE_URL=postgresql://YOUR_RUNTIME_ROLE:YOUR_PASSWORD@YOUR_HOST:5432/postgres
# Provider credentials and DATABASE_URL must never use NEXT_PUBLIC_ or VITE_.
