# Local configuration belongs in apps/web/.env.local (ignored).
# Builds, tests and the public page need no credentials.
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
# These two values are public. Never substitute a secret/service-role key.

# Exact website origin (no path or trailing slash) for website Google callbacks.
# AUTH_SITE_URL=http://127.0.0.1:3000
# Enable only after configuring Google's provider and exact redirects in Supabase.
# GOOGLE_AUTH_ENABLED=false
# Google client ID/secret belong in Supabase's Google provider settings, not here.

# Server-only recorded transcription and speech generation.
# ELEVENLABS_API_KEY=YOUR_ELEVENLABS_API_KEY
# ELEVENLABS_STT_MODEL=scribe_v2
# ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
# ELEVENLABS_VOICE_ID=YOUR_ACCOUNT_VOICE_ID

# Server-only orders interpretation and structured article answers. No key is
# needed for builds, tests, /orders, /reading-demo, or local source inspection.
# AVIS_API_KEY=YOUR_AVIS_API_KEY
# AVIS_API_BASE_URL=https://api.avis.xyz/api/openai/v1
# AVIS_AI_MODEL=YOUR_AVIS_MODEL_ID
# Visual reading is disabled until one synthetic multi-image check verifies this
# exact Avis URL/model/profile. Run npm run check:avis:visual --workspace=@adc/web.
# Set the public verification hash printed ONLY after that check passes.
# Changing AVIS_API_BASE_URL or AVIS_AI_MODEL invalidates this value.
# AVIS_VISUAL_VERIFIED_ROUTE=YOUR_SUCCESSFUL_VISUAL_CHECK_HASH
# All three Avis settings are required. No direct OpenAI key or fallback is used.
# Structured page reading currently verifies the gpt-6-astra model profile only.
# It uses the same Avis settings; unknown model profiles fail with a setup message.
# The 6000-input-token ceiling uses a conservative UTF-8 byte bound (not a token
# estimate), including instructions/schema and framing reserve. Long captures
# can exceed it before reaching the separate 20000-Unicode-character ceiling;
# select a shorter section. No extra paid token-count request or retry is made.
# Exact origins serving /orders, comma separated. Required in production.
# GROUNDED_ALLOWED_ORIGINS=https://YOUR_DEPLOYMENT.vercel.app
# Local defaults: http://127.0.0.1:3000,http://localhost:3000

# Restricted non-owner, non-BYPASSRLS PostgreSQL runtime role; see README.
# DATABASE_URL=postgresql://YOUR_RUNTIME_ROLE:YOUR_PASSWORD@YOUR_HOST:5432/postgres?sslmode=verify-full
# The backend bundles Supabase's public CA and verifies the certificate and hostname.
# VA_VOICE_WORKSPACE_ID=YOUR_WORKSPACE_UUID
# Comma-separated exact extension origins, no wildcard or trailing slash.
# VOICE_ALLOWED_ORIGINS=chrome-extension://YOUR_EXTENSION_ID
# Provider credentials and DATABASE_URL must never use NEXT_PUBLIC_ or VITE_.

# Server-only shared application request limits (not provider credits).
# npm run dev:web defaults: 30 per rolling minute and 1000 per rolling 24 hours.
# Production/test defaults: 6 per rolling minute and 30 per rolling 24 hours.
# Optional explicit overrides for local or controlled Preview testing:
# VOICE_REQUESTS_PER_MINUTE=30
# VOICE_REQUESTS_PER_DAY=1000
# Positive integers only: minute 1..600, day 1..10000. No unlimited/zero mode.
# Transcription, answers and speech share these per-account counts across workspaces.
# For Vercel, configure the intended environment and redeploy. Provider limits remain separate.
