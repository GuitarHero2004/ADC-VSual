# Optional web Auth configuration; the public foundation runs without it.
# Copy to .env.local and uncomment both values to configure Supabase Auth.
# NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
# These two values are public. Never substitute a secret/service-role key.

# Reserved for later backend-only database integration; currently unused.
# DATABASE_URL=postgresql://YOUR_RUNTIME_ROLE:YOUR_PASSWORD@YOUR_HOST:5432/postgres
# Provider credentials and DATABASE_URL must never use NEXT_PUBLIC_ or VITE_.
