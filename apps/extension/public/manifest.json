{
  "manifest_version": 3,
  "name": "Browser Accessibility Agent - Foundation",
  "description": "An accessible side-panel shell for the RMIT ADC Hackathon browser assistant.",
  "version": "0.0.1",
  "minimum_chrome_version": "114",
  "permissions": ["sidePanel"],
  "action": {
    "default_title": "Open browser assistant"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      }
    }
  }
}
