# Public browser settings only. Copy to .env.local and rebuild/reload the extension.
VITE_API_BASE_URL=http://127.0.0.1:3000
# Also controls the trusted /auth/sign-in website. Rebuild/reload after changes.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Exact origins serving the supported /orders page; defaults to VITE_API_BASE_URL.
# VITE_ORDERS_ORIGINS=http://127.0.0.1:3000
# Never put an Avis/ElevenLabs API key, database password or service-role key here.
