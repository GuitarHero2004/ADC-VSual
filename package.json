{
  "name": "rmit-adc-browser-assistant",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.13.0",
  "scripts": {
    "dev": "concurrently --kill-others --names web,extension \"npm:dev:web\" \"npm:dev:extension\"",
    "dev:web": "npm run dev --workspace @adc/web",
    "dev:extension": "npm run dev --workspace @adc/extension",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "npm run build --workspaces --if-present",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.13.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "concurrently": "10.0.5",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "prettier": "3.9.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0"
  }
}
